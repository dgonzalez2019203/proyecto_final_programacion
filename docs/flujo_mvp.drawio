<mxfile host="app.diagrams.net"><diagram name="Flujo MVP NovaBank" id="mvp"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="datos" value="&lt;b&gt;Datos sintéticos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;generar_datos.py&lt;br&gt;1,200 clientes · 8 fuentes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8F5;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="ingesta" value="&lt;b&gt;Ingesta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ingesta.py + validar_datos.py&lt;br&gt;24 verificaciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8F5;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="datos" target="ingesta"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="almacen" value="&lt;b&gt;SQLite&lt;br&gt;Bronze·Silver·Gold&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;novabank.db&lt;br&gt;10 + 11 + 9 tablas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9C9;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="ingesta" target="almacen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="modelo" value="&lt;b&gt;Modelo NBO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modelos.py&lt;br&gt;boosting + abandono + fraude&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2EC;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="almacen" target="modelo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prediccion" value="&lt;b&gt;Predicción + reglas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;predecir.py · reglas.py&lt;br&gt;R1–R8 → mejor acción&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2EC;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="modelo" target="prediccion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET /recomendacion/{id}&lt;br&gt;POST /acciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E0F5;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="prediccion" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="auto" value="&lt;b&gt;Automatización&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;flujo_local.py (APScheduler)&lt;br&gt;trigger → regla → correo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E0F5;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="api" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bi" value="&lt;b&gt;Tablero BI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Looker Studio&lt;br&gt;zona Gold → 3 páginas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5E0E0;strokeColor=#1B2A3A;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;strokeColor=#1B2A3A;" edge="1" parent="1" source="auto" target="bi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fb" value="acciones registradas en gold_acciones_enviadas" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;dashed=1;endArrow=blockThin;strokeColor=#0A7C6A;fontColor=#0A7C6A;fontSize=9;" edge="1" parent="1" source="auto" target="almacen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="300"/><mxPoint x="500" y="300"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>